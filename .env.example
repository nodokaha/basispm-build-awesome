# Basis source branch/tag/commit
BASIS_REF=developer
BASIS_REPOSITORY=https://github.com/BasisVR/Basis.git
BASISPM_REPOSITORY=https://github.com/BasisVR/BasisPackageManager.git
TCP_TRANSPORT_REPOSITORY=https://github.com/dooly123/Basis-TCP-Transport-Package.git

IMAGE_NAME=ghcr.io/nodokaha/basispm-build-awesome:latest
BASIS_PASSWORD=replace-this-with-a-long-random-password
SET_PORT=4296
HEALTH_CHECK_PORT=10666
PROMETHEUS_PORT=1234
PEER_LIMIT=1024
ENABLE_STATISTICS=true
ENABLE_CONSOLE=false
USING_LOGGING_FILE=true
NETWORK_STACK_ID=litenetlib,websocket
